{
  "name": "dz23-tradingview-assistant",
  "version": "2.17.0",
  "description": "Copiloto de IA para TradingView com gateway local, inteligência de mercado e laboratório de estratégias",
  "private": true,
  "license": "GPL-3.0",
  "scripts": {
    "browser": "node _aitna/tools/browser/cli.mjs",
    "github": "node _aitna/tools/github/cli.mjs",
    "release:check": "node _aitna/tools/release/cli.mjs check --offline --dev",
    "release:pack": "node _aitna/tools/release/cli.mjs pack --offline --dev",
    "release:verify": "node _aitna/tools/release/cli.mjs verify",
    "i18n:check": "node _aitna/tools/i18n/cli.mjs check",
    "i18n:merge": "node _aitna/tools/i18n/cli.mjs merge",
    "dz23:ingest": "node dz23/serve.mjs",
    "mcp": "node mcp/cli.mjs",
    "gateway": "node gateway/server.mjs",
    "gateway:dev": "node scripts/gateway-dev.mjs",
    "lint": "eslint .",
    "test:ext": "node --test \"_aitna/tools/extension-tests/*.test.mjs\"",
    "test:bridge": "node \"_aitna/tools/e2e/bridge-e2e.mjs\"",
    "test:e2e": "node \"_aitna/tools/e2e/copilot-e2e.mjs\"",
    "test:dz23": "node --test \"dz23/*.test.mjs\"",
    "test:mcp": "node --test \"mcp/*.test.mjs\"",
    "test:gateway": "node --test gateway/*.test.mjs",
    "test:quant": "node --test \"_aitna/tools/extension-tests/quant.test.mjs\" \"_aitna/tools/extension-tests/fromBacktest.test.mjs\" \"_aitna/tools/extension-tests/overfitting-contract.test.mjs\"",
    "test:tools": "node --test \"_aitna/tools/**/*.test.mjs\"",
    "host:install": "node native-host/install.mjs",
    "host:uninstall": "node native-host/install.mjs --uninstall",
    "test:native": "node --test \"_aitna/tools/extension-tests/native-host.test.mjs\"",
    "pine:check": "node _aitna/tools/pine/cli.mjs",
    "test:pine-ui": "node \"_aitna/tools/e2e/research-pine.mjs\"",
    "test:settings-ui": "node \"_aitna/tools/e2e/settings-page.mjs\"",
    "agents": "node _aitna/tools/agents/cli.mjs",
    "test:agents": "node --test \"_aitna/tools/extension-tests/agents.test.mjs\"",
    "tv:mcp": "node mcp/tradingview-cli.mjs",
    "test:mcp-tv": "node --test \"_aitna/tools/extension-tests/mcp-tradingview.test.mjs\"",
    "compare": "node _aitna/tools/compare/cli.mjs",
    "test:compare": "node --test \"_aitna/tools/extension-tests/compare.test.mjs\" \"_aitna/tools/extension-tests/compareAssets.test.mjs\"",
    "pine:gen": "node _aitna/tools/pine/gen.mjs",
    "test:a11y": "node _aitna/tools/e2e/a11y.mjs",
    "pine:explain": "node _aitna/tools/pine/explain.mjs",
    "strat:compare": "node _aitna/tools/strategy/compare.mjs",
    "test:strategy": "node --test \"_aitna/tools/extension-tests/compareStrategies.test.mjs\"",
    "docs:check": "node _aitna/tools/docs/check.mjs",
    "security:check": "node _aitna/tools/security/check.mjs",
    "backup": "node _aitna/tools/backup/create.mjs",
    "backup:check": "node _aitna/tools/backup/check.mjs",
    "compare-assets": "node _aitna/tools/compare/assets.mjs",
    "accept": "node _aitna/tools/accept/cli.mjs",
    "perf:check": "node _aitna/tools/perf/check.mjs",
    "perf:pages": "node _aitna/tools/perf/pages.mjs",
    "test:coverage": "npx --yes c8@10.1.3 --check-coverage --lines 92 --branches 68 --functions 80 --reporter=text node --test \"_aitna/tools/extension-tests/*.test.mjs\"",
    "audit:orphans": "node _aitna/tools/audit/orphans.mjs",
    "audit:gate": "node _aitna/tools/audit/gate.mjs",
    "dz23:send": "node _aitna/tools/dz23/send.mjs",
    "audit:controls": "node _aitna/tools/audit/controls.mjs",
    "audit:mutation": "node _aitna/tools/audit/mutation.mjs",
    "audit:package": "node _aitna/tools/audit/package.mjs",
    "audit:exports": "node _aitna/tools/audit/exports.mjs",
    "audit:numbers": "node _aitna/tools/audit/numbers.mjs",
    "verify": "node _aitna/tools/audit/gate.mjs && npm run release:pack && node _aitna/tools/audit/package.mjs && node _aitna/tools/audit/numbers.mjs",
    "smoke:live": "node _aitna/tools/e2e/live-smoke.mjs",
    "probe:api": "node _aitna/tools/e2e/api-probe.mjs",
    "audit:secrets": "node _aitna/tools/audit/secrets.mjs",
    "docs:screenshots": "node _aitna/tools/e2e/shots.mjs",
    "audit:permissions": "node _aitna/tools/audit/permissions.mjs",
    "audit:test-files": "node _aitna/tools/audit/test-coverage.mjs",
    "audit:readme": "node _aitna/tools/audit/readme.mjs",
    "audit:identity": "node _aitna/tools/audit/identity.mjs"
  },
  "devDependencies": {
    "akmon": "git+https://github.com/akumidv/ai_akmon.git#3a7c54016e2d1b7771ea02ed578a03dff7db7217",
    "chrome-devtools-mcp": "1.10.1",
    "eslint": "10.13.0",
    "puppeteer": "25.13.0"
  },
  "allowScripts": {
    "puppeteer@25.13.0": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LMPrado-DZ23/dz23-tradingview-assistant.git"
  },
  "homepage": "https://github.com/LMPrado-DZ23/dz23-tradingview-assistant#readme",
  "bugs": {
    "url": "https://github.com/LMPrado-DZ23/dz23-tradingview-assistant/issues"
  },
  "author": "DZ23 (obra derivada de akumidv/tradingview-assistant-chrome-extension)"
}
